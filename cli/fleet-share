def canonical_hint(raw):
    text = str(raw or "").strip()
    if re.fullmatch(r"grok[^a-z0-9]*build[^a-z0-9]*", text, re.IGNORECASE | re.ASCII):
        return "GROK"
    return SEAT_ALIASES.get(text.upper(), text.upper())


class GatewayTransport:
    """One verified TLS connection per client. No redirects, proxy or retries."""

    def __init__(self):
        self.connection = None

    def close(self):
        if self.connection is not None:
            self.connection.close()
            self.connection = None

    def open(self, request, timeout=40):
        if request.full_url != ENDPOINT or request.get_method() != "POST":
            raise ValueError("fixed gateway only")
        if self.connection is None:
            self.connection = http.client.HTTPSConnection(
                "agents.simplewithus.com", timeout=timeout
            )
        try:
            self.connection.request(
                "POST", "/mcp", body=request.data, headers=dict(request.header_items())
            )
            response = self.connection.getresponse()
            if response.status != 200:
                status = response.status
                self.close()
                raise urllib.error.HTTPError(ENDPOINT, status, "gateway refusal", {}, None)
            return response
        except Exception:
            self.close()
            raise


def gateway_transport():
    return GatewayTransport()


class Client:
    def __init__(self, path, expected_seat=None, identity_env=None):
        self._transport = gateway_transport()
        self.path = path
        self.seat, _ = private_bearer(path)
        identity_env = os.environ if identity_env is None else identity_env
        # Non-secret launcher hints can restrict, never select another bearer.
        for name in ("AGENT_LAUNCH_SEAT", "AGENT_SEAT", "AGENT_TAG"):
            value = canonical_hint(identity_env.get(name, ""))
            if value and value != self.seat:
                raise FleetError(
                    "not_authorized", "fleet bearer conflicts with the current bot identity"
                )
        if identity_env.get("AGENT_LAUNCHER") and not identity_env.get("AGENT_LAUNCH_SEAT"):
            raise FleetError("not_authorized", "launcher did not bind a bot identity")
        if expected_seat is not None and self.seat != canonical_hint(expected_seat):
            raise FleetError("not_authorized", "fleet bearer does not name the requested bot")
        self.verified = False
        self._verified_token = None

    def rpc(self, method, params, write=False):
        seat, token = private_bearer(self.path)
        if seat != self.seat:
            raise FleetError("not_authorized", "fleet bearer identity changed; nothing was sent")
        unknown = "; outcome unknown, check before repeating the write" if write else ""
        body = json.dumps(
            {"jsonrpc": "2.0", "id": 1, "method": method, "params": params}, allow_nan=False
        ).encode()
        if len(body) > MAX_BYTES or contains_bearer(params, token):
            raise FleetError(
                "invalid_argument",
                "request too large or contains the fleet bearer; nothing was sent",
            )
        request = urllib.request.Request(
            ENDPOINT,
            data=body,
            method="POST",
            headers={
                "Authorization": "Bearer " + token,
                "Content-Type": "application/json",
                "Accept": "application/json, text/event-stream",
                "MCP-Protocol-Version": "2025-06-18",
                "User-Agent": "fleet-bearer-client/1",
            },
        )
        try:
            # No environment proxy, cookies, redirects or retry.
            with self._transport.open(request, timeout=40) as response:
                raw = response.read(MAX_BYTES + 1)
                ctype = response.headers.get("Content-Type", "").split(";", 1)[0].strip()
            if len(raw) > MAX_BYTES or token.encode() in raw:
                raise ValueError
            text = raw.decode("utf-8")
            if ctype == "text/event-stream":
                candidates = [
                    "\n".join(
                        line[5:].lstrip(" ")
                        for line in event.splitlines()
                        if line.startswith("data:")
                    )
                    for event in text.replace("\r\n", "\n").split("\n\n")
                ]
            elif ctype == "application/json":
                candidates = [text]
            else:
                raise ValueError
            replies = [bounded_json(part) for part in candidates if part.strip()]
            replies = [
                r
                for r in replies
                if isinstance(r, dict)
                and r.get("jsonrpc") == "2.0"
                and type(r.get("id")) is int
                and r["id"] == 1
            ]
            if len(replies) != 1:
                raise ValueError
            reply = replies[0]
            if contains_bearer(reply, token):
                raise ValueError
            if "error" in reply or not isinstance(reply.get("result"), dict):
                raise ValueError
            result = reply["result"]
            if not isinstance(result.get("isError", False), bool):
                raise TypeError
            if "content" in result and (
                not isinstance(result["content"], list)
                or any(not isinstance(p, dict) for p in result["content"])
            ):
                raise ValueError
            if result.get("isError"):
                sc = result.get("structuredContent")
                code = sc.get("code") if isinstance(sc, dict) else None
                if not isinstance(code, str) or not re.fullmatch(r"[a-z_]{1,40}", code):
                    code = "upstream_error"
                raise FleetError(code, "gateway refused the call (" + code + ")" + unknown)
            return result
        except urllib.error.HTTPError as exc:
            uncertain = write and (exc.code in (408, 429) or exc.code >= 500)
            code = (
                "not_authorized"
                if exc.code in (401, 403)
                else ("outcome_unknown" if uncertain else "unavailable")
            )
            raise FleetError(
                code,
                "gateway HTTP " + str(exc.code) + (unknown if uncertain else ""),
            ) from None
        except FleetError:
            raise
        except (
            OSError,
            ValueError,
            TypeError,
            RecursionError,
            http.client.HTTPException,
            urllib.error.URLError,
        ):
            self._transport.close()
            raise FleetError(
                "outcome_unknown" if write else "unavailable",
                "gateway transport or response failed" + unknown,
            ) from None

    def call(self, name, arguments, write=False):
        _, token = private_bearer(self.path)
        if not self.verified or token != self._verified_token:
            who = self.rpc("tools/call", {"name": "whoami", "arguments": {}}).get(
                "structuredContent"
            )
            if (
                not isinstance(who, dict)
                or who.get("authenticated_seat") != self.seat
                or who.get("seat") != self.seat
            ):
                raise FleetError(
                    "not_authorized", "gateway identity did not match this bot; nothing was sent"
                )
            self.verified = True
            self._verified_token = token
        return self.rpc("tools/call", {"name": name, "arguments": arguments}, write)

# END shared private-file fleet bearer client

class FleetApi:
    """REST-shaped local adapter. The gateway authenticates; FleetLink authorizes."""
    def __init__(self, args):
        if args.token or args.operator or args.domain or os.environ.get("FLEETLINK_DOMAIN"):
            raise CliError("Fleet bearer mode cannot mix a provider token, operator credential or alternate domain.")
        self.client = Client(args.fleet_bearer_file)

    def tool(self, name, arguments):
        if not isinstance(name, str) or not name.startswith("fleetlink_"):
            raise CliError("Only FleetLink tools are available in fleet bearer mode.")
        result = self.client.call(name, arguments, write=name not in {"fleetlink_whoami", "fleetlink_get_share", "fleetlink_list_shares", "fleetlink_list_teams", "fleetlink_read_file"})
        # The summary omits file bytes and complete share/account metadata. Read the
        # exact single-line JSON inside the gateway's nonce-paired data fence.
        for part in result.get("content", []):
            text = part.get("text", "")
            if not isinstance(text, str):
                continue
            match = re.search(r"(?m)^BEGIN_UNTRUSTED_FLEETLINK nonce=([A-Za-z0-9_-]+)\n([^\n]*)\nEND_UNTRUSTED_FLEETLINK nonce=\1$", text)
            if match:
                try:
                    data = bounded_json(match[2])
                except (ValueError, TypeError, RecursionError):
                    raise CliError("Gateway returned no complete FleetLink result; a write may have landed. Check before repeating.") from None
                if isinstance(data, dict):
                    return data
        raise CliError("Gateway returned no complete FleetLink result; a write may have landed. Check before repeating.")

    @staticmethod
    def number(value, convert, name):
        try:
            out = convert(value)
            if not math.isfinite(out):
                raise ValueError
            return out
        except (ValueError, TypeError, OverflowError):
            raise CliError("Invalid " + name + " value; nothing was sent.") from None

    def request(self, method, path, body=None, data=None, headers=None, length=None):
        if path == "/mcp":
            if body["method"] == "tools/call":
                out = self.tool(body["params"]["name"], body["params"].get("arguments", {}))
                return {"result": {"content": [{"type": "text", "text": json.dumps(out)}]}}
            if body["method"] == "tools/list":
                result = self.client.rpc("tools/list", {})
                return {"result": {"tools": [t for t in result.get("tools", []) if t.get("name", "").startswith("fleetlink_")]}}
            raise CliError("Unsupported MCP method in fleet bearer mode.")
        parsed = urllib.parse.urlsplit(path)
        parts = [urllib.parse.unquote(p) for p in parsed.path.split("/") if p]
        query = dict(urllib.parse.parse_qsl(parsed.query))
        args = dict(body or {})
        name = None
        if parts == ["api", "me"] and method == "GET":
            name = "fleetlink_whoami"
        elif parts == ["api", "teams"] and method == "GET":
            name = "fleetlink_list_teams"
        elif parts == ["api", "links"] and method == "POST":
            name = "fleetlink_create_link"
        elif parts == ["api", "shares"]:
            if method == "GET":
                name, args = "fleetlink_list_shares", query
                if "limit" in args:
                    args["limit"] = self.number(args["limit"], int, "limit")
            elif method == "POST":
                name = "fleetlink_create_share"
                args["empty"] = True
                if "days" in args and args["days"] != "forever":
                    args["days"] = self.number(args["days"], float, "days")
        elif parts[:2] == ["api", "shares"] and len(parts) >= 3:
            args["slug"] = parts[2]
            if len(parts) == 3:
                if method == "GET":
                    name = "fleetlink_get_share"
                elif method == "DELETE":
                    name = "fleetlink_delete_share"
                elif method == "PATCH":
                    if "team_id" in args:
                        team = args.pop("team_id")
                        if team is None:
                            name = "fleetlink_make_personal"
                        else:
                            name = "fleetlink_share_to_team"
                            args["team_id"] = team
                            args["access"] = args.pop("team_access", "edit")
                    else:
                        name = "fleetlink_update_share"
                        if body and "slug" in body:
                            args["new_slug"] = body["slug"]
                            args["slug"] = parts[2]
            elif parts[3] == "renew" and method == "POST":
                name = "fleetlink_renew_share"
            elif parts[3] == "upload-url" and method == "POST":
                name = "fleetlink_upload_url"
            elif parts[3] == "files" and len(parts) > 4:
                args["path"] = "/".join(parts[4:])
                if method == "DELETE":
                    name = "fleetlink_delete_file"
                elif method == "PUT":
                    args.update({"max_bytes": max(1, length), "content_type": headers["Content-Type"]})
                    grant = self.tool("fleetlink_upload_url", args)
                    return self.stream(grant, data, length, args["path"], parts[2])
        if name is None:
            raise CliError("This account/admin operation is not exposed by the fleet gateway. No provider fallback was used; use an explicit human/operator session for account management.")
        if "days" in args and args["days"] != "forever":
            args["days"] = self.number(args["days"], float, "days")
        return self.tool(name, args)

    def stream(self, grant, handle, length, path, slug):
        upload = grant.get("upload", {})
        url = upload.get("upload_url", "")
        parsed = urllib.parse.urlsplit(url)
        try:
            expiry = datetime.fromisoformat(upload["expires_at"].replace("Z", "+00:00"))
            remaining = expiry.timestamp() - time.time()
            valid = (parsed.scheme == "https" and parsed.netloc == "fleetlink.online"
                     and not parsed.query and not parsed.fragment
                     and re.fullmatch(r"/api/uploads/flu_[0-9a-f]{64}", parsed.path)
                     and upload.get("path") == path and (grant.get("share") or {}).get("slug") == slug
                     and expiry.tzinfo is not None and 0 < remaining <= 1800
                     and type(upload.get("max_bytes")) is int and length <= upload["max_bytes"])
            if not valid:
                raise ValueError
        except (KeyError, ValueError, TypeError, AttributeError, OverflowError):
            raise CliError("Invalid or expired upload grant. No bytes sent; check the share before repeating.") from None
        request = urllib.request.Request(url, data=handle, method="PUT", headers={
            "Content-Type": upload.get("content_type", "application/octet-stream"), "Content-Length": str(length)})
        try:
            opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
            with opener.open(request, timeout=min(600, remaining)) as response:
                raw = response.read(MAX_BYTES + 1)
                if len(raw) > MAX_BYTES:
                    raise ValueError
                out = bounded_json(raw.decode())
                if not isinstance(out, dict):
                    raise ValueError
                return out
        except (OSError, ValueError, http.client.HTTPException, urllib.error.URLError):
            raise CliError("Streamed upload outcome unknown. No retry or cleanup was attempted; inspect the share first.") from None

    def get(self, path):
        return self.request("GET", path)

    def post(self, path, body=None):
        return self.request("POST", path, body)

    def patch(self, path, body):
        return self.request("PATCH", path, body)

    def delete(self, path, body=None):
        return self.request("DELETE", path, body)


# ---------------------------------------------------------------- credentials

def config_dir():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, "fleetlink")


def credentials_path():
    return os.environ.get("FLEETLINK_CREDENTIALS") or os.path.join(config_dir(), "credentials")


def strip_quotes(value):
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        return value[1:-1]
    return value


def read_kv_file(path):
    out = {}
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            out[key.strip()] = strip_quotes(value)
    return out


def resolve_auth(args):
    """Return (header_name, value, label).  Order: flag, env, auth file, saved login, operator secret."""
    if getattr(args, "agent", False):
        raise CliError("The shared agent secret is retired.  Create an API token on your dashboard and set FLEETLINK_TOKEN.")
    if args.token:
        return ("Authorization", "Bearer " + args.token.strip(), "--token")
    env_token = os.environ.get("FLEETLINK_TOKEN", "").strip()
    if env_token and not args.operator:
        return ("Authorization", "Bearer " + env_token, "FLEETLINK_TOKEN")
    files = []
    if os.environ.get("FLEETLINK_AUTH_FILE"):
        if not os.path.isfile(os.environ["FLEETLINK_AUTH_FILE"]):
            raise CliError("FLEETLINK_AUTH_FILE is set but the file does not exist.")
        files.append(os.environ["FLEETLINK_AUTH_FILE"])
    else:
        files.extend(f for f in ("./fleet-link-auth.env", "./.fleet-link-auth.env") if os.path.isfile(f))
    for path in files:
        values = read_kv_file(path)
        if values.get("FLEETLINK_TOKEN") and not args.operator:
            return ("Authorization", "Bearer " + values["FLEETLINK_TOKEN"], path)
        for key in ("FLEET_ADMIN_SECRET", "ADMIN_SECRET", "FLEET_AUTH_SECRET"):
            if values.get(key):
                return ("X-Fleet-Admin", values[key], path + " (operator)")
        break
    if not args.operator and os.path.isfile(credentials_path()):
        saved = read_kv_file(credentials_path())
        if saved.get("FLEETLINK_TOKEN"):
            return ("Authorization", "Bearer " + saved["FLEETLINK_TOKEN"], "saved login")
    for key in ("FLEET_ADMIN_SECRET", "ADMIN_SECRET"):
        if os.environ.get(key, "").strip():
            return ("X-Fleet-Admin", os.environ[key].strip(), key + " (operator)")
    raise CliError(
        "Not signed in.  Create an API token at " + domain(args) + "/dashboard#tokens, then run "
        "`fleet-share login` or set FLEETLINK_TOKEN."
    )


def domain(args):
    return (getattr(args, "domain", None) or os.environ.get("FLEETLINK_DOMAIN") or DEFAULT_DOMAIN).rstrip("/")


# ----------------------------------------------------------------------- http

class Api:
    def __new__(cls, args, auth=True):
        if auth and getattr(args, "fleet_bearer_file", None) is not None:
            return FleetApi(args)
        return super().__new__(cls)

    def __init__(self, args, auth=True):
        self.base = domain(args)
        self.header = resolve_auth(args) if auth else None

    def request(self, method, path, body=None, data=None, headers=None, length=None):
        url = path if path.startswith("http") else self.base + path
        h = {"Accept": "application/json", "User-Agent": "fleet-share/" + VERSION}
        if self.header:
            h[self.header[0]] = self.header[1]
        if body is not None:
            data = json.dumps(body).encode()
            h["Content-Type"] = "application/json"
        if headers:
            h.update(headers)
        if length is not None:
            h["Content-Length"] = str(length)
        req = urllib.request.Request(url, data=data, method=method, headers=h)
        try:
            with urllib.request.urlopen(req, timeout=600) as res:
                raw = res.read()
                return json.loads(raw.decode() or "{}")
        except urllib.error.HTTPError as err:
            raw = err.read().decode("utf-8", "replace")
            try:
                message = json.loads(raw).get("error") or raw
            except ValueError:
                message = raw.strip() or err.reason
            raise CliError("{} (HTTP {})".format(message, err.code))
        except urllib.error.URLError as err:
            raise CliError("Could not reach {}: {}".format(self.base, err.reason))

    def get(self, path):
        return self.request("GET", path)

    def post(self, path, body=None):
        return self.request("POST", path, body=body if body is not None else {})

    def patch(self, path, body):
        return self.request("PATCH", path, body=body)

    def put_json(self, path, body):
        return self.request("PUT", path, body=body)

    def delete(self, path, body=None):
        return self.request("DELETE", path, body=body)


def q(value):
    return urllib.parse.quote(str(value), safe="")


def qpath(value):
    return "/".join(urllib.parse.quote(part, safe="") for part in value.split("/"))


def emit(args, data, text_lines):
    if getattr(args, "json", False):
        print(json.dumps(data, indent=2))
    else:
        for line in text_lines:
            print(line)


def human_bytes(n):
    n = float(n or 0)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return ("{:.0f} {}" if unit == "B" or n >= 10 else "{:.1f} {}").format(n, unit)
        n /= 1024


