        data = api.get("/api/bots/{}/tokens".format(q(bot)))
        emit(args, data, ["{}  {}  {}…  {}  last used {}".format(t["id"], t["name"], t["prefix"], "follows your limits" if t.get("limits_from") == "manager" else "bot's own limits", t["last_used_at"] or "never") for t in data["tokens"]] or ["No tokens."])
    elif args.action == "revoke":
        if len(rest) < 2:
            raise CliError("fleet-share bots revoke BOT TOKEN_ID")
