#!/usr/bin/env python3
"""fleet-share: the FleetLink command-line client.

Every call acts as one FleetLink account.  Authenticate with an API token
(create one on https://fleetlink.online/dashboard#tokens), then:

    fleet-share login                       save a token for later commands
    fleet-share notes.md ./report/          upload files and folders as one share
    fleet-share link https://example.com    make a short link
    fleet-share list | info | renew | delete
    fleet-share tokens | teams | admin      account, team, and admin tools
    fleet-share skill install               install the agent skill

Python 3.8+ standard library only.  Credentials are never printed.
"""
import argparse
import base64
import getpass
import hashlib
import json
import mimetypes
import os
import stat
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

VERSION = "2.0.0"
DEFAULT_DOMAIN = "https://fleetlink.online"

# Remote skill installer pin.  The SHA-256 values are the integrity check: a
# download that does not match is deleted and never run.  The git SHA names a
# commit that already published those bytes; it is an ancestor of the commit
# that records it, because a commit cannot contain its own id.
FLEETLINK_PINNED_GIT_SHA_DEFAULT = 'd45b1e049f9d5c87e32101525df0ade3f24b5c54'
FLEETLINK_INSTALLER_SHA256_DEFAULT = 'e8bf443e751ad50c5dd795c2348cdda28752afda9d9d42d55dd60deb5094d6ce'
FLEETLINK_SKILL_MD_SHA256_DEFAULT = 'caa708f877a06a8b549e65722182f4191a49da86bec5c3386544576bf4264546'

TEXT_TYPES = {
    ".md": "text/markdown; charset=utf-8",
    ".markdown": "text/markdown; charset=utf-8",
    ".txt": "text/plain; charset=utf-8",
    ".log": "text/plain; charset=utf-8",
    ".json": "application/json; charset=utf-8",
    ".html": "text/html; charset=utf-8",
    ".htm": "text/html; charset=utf-8",
    ".csv": "text/csv; charset=utf-8",
    ".svg": "image/svg+xml",
    ".shortcut": "application/x-apple-shortcut",
    ".mobileconfig": "application/x-apple-aspen-config",
}


class CliError(Exception):
    pass


# ---------------------------------------------------------------- credentials

def config_dir():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, "fleetlink")


def credentials_path():
    return os.environ.get("FLEETLINK_CREDENTIALS") or os.path.join(config_dir(), "credentials")


def strip_quotes(value):
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        return value[1:-1]
    return value


def read_kv_file(path):
    out = {}
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            out[key.strip()] = strip_quotes(value)
    return out


def resolve_auth(args):
    """Return (header_name, value, label).  Order: flag, env, auth file, saved login, operator secret."""
    if getattr(args, "agent", False):
        raise CliError("The shared agent secret is retired.  Create an API token on your dashboard and set FLEETLINK_TOKEN.")
    if args.token:
        return ("Authorization", "Bearer " + args.token.strip(), "--token")
    env_token = os.environ.get("FLEETLINK_TOKEN", "").strip()
    if env_token and not args.operator:
        return ("Authorization", "Bearer " + env_token, "FLEETLINK_TOKEN")
    files = []
    if os.environ.get("FLEETLINK_AUTH_FILE"):
        if not os.path.isfile(os.environ["FLEETLINK_AUTH_FILE"]):
            raise CliError("FLEETLINK_AUTH_FILE is set but the file does not exist.")
        files.append(os.environ["FLEETLINK_AUTH_FILE"])
    else:
        files.extend(f for f in ("./fleet-link-auth.env", "./.fleet-link-auth.env") if os.path.isfile(f))
    for path in files:
        values = read_kv_file(path)
        if values.get("FLEETLINK_TOKEN") and not args.operator:
            return ("Authorization", "Bearer " + values["FLEETLINK_TOKEN"], path)
        for key in ("FLEET_ADMIN_SECRET", "ADMIN_SECRET", "FLEET_AUTH_SECRET"):
            if values.get(key):
                return ("X-Fleet-Admin", values[key], path + " (operator)")
        break
    if not args.operator and os.path.isfile(credentials_path()):
        saved = read_kv_file(credentials_path())
        if saved.get("FLEETLINK_TOKEN"):
            return ("Authorization", "Bearer " + saved["FLEETLINK_TOKEN"], "saved login")
    for key in ("FLEET_ADMIN_SECRET", "ADMIN_SECRET"):
        if os.environ.get(key, "").strip():
            return ("X-Fleet-Admin", os.environ[key].strip(), key + " (operator)")
    raise CliError(
        "Not signed in.  Create an API token at " + domain(args) + "/dashboard#tokens, then run "
        "`fleet-share login` or set FLEETLINK_TOKEN."
    )


def domain(args):
    return (getattr(args, "domain", None) or os.environ.get("FLEETLINK_DOMAIN") or DEFAULT_DOMAIN).rstrip("/")


# ----------------------------------------------------------------------- http

class Api:
    def __init__(self, args, auth=True):
        self.base = domain(args)
        self.header = resolve_auth(args) if auth else None

    def request(self, method, path, body=None, data=None, headers=None, length=None):
        url = path if path.startswith("http") else self.base + path
        h = {"Accept": "application/json", "User-Agent": "fleet-share/" + VERSION}
        if self.header:
            h[self.header[0]] = self.header[1]
        if body is not None:
            data = json.dumps(body).encode()
            h["Content-Type"] = "application/json"
        if headers:
            h.update(headers)
        if length is not None:
            h["Content-Length"] = str(length)
        req = urllib.request.Request(url, data=data, method=method, headers=h)
        try:
            with urllib.request.urlopen(req, timeout=600) as res:
                raw = res.read()
                return json.loads(raw.decode() or "{}")
        except urllib.error.HTTPError as err:
            raw = err.read().decode("utf-8", "replace")
            try:
                message = json.loads(raw).get("error") or raw
            except ValueError:
                message = raw.strip() or err.reason
            raise CliError("{} (HTTP {})".format(message, err.code))
        except urllib.error.URLError as err:
            raise CliError("Could not reach {}: {}".format(self.base, err.reason))

    def get(self, path):
        return self.request("GET", path)

    def post(self, path, body=None):
        return self.request("POST", path, body=body if body is not None else {})

    def patch(self, path, body):
        return self.request("PATCH", path, body=body)

    def put_json(self, path, body):
        return self.request("PUT", path, body=body)

    def delete(self, path, body=None):
        return self.request("DELETE", path, body=body)


def q(value):
    return urllib.parse.quote(str(value), safe="")


def qpath(value):
    return "/".join(urllib.parse.quote(part, safe="") for part in value.split("/"))


def emit(args, data, text_lines):
    if getattr(args, "json", False):
        print(json.dumps(data, indent=2))
    else:
        for line in text_lines:
            print(line)


def human_bytes(n):
    n = float(n or 0)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return ("{:.0f} {}" if unit == "B" or n >= 10 else "{:.1f} {}").format(n, unit)
        n /= 1024


# ------------------------------------------------------------------- commands

def collect_files(targets):
    files = []
    for target in targets:
        target = target.rstrip("/") or target
        if os.path.isdir(target):
            base = os.path.basename(os.path.abspath(target))
            for root, dirs, names in os.walk(target):
                dirs.sort()
                for name in sorted(names):
                    full = os.path.join(root, name)
                    rel = os.path.relpath(full, target).replace(os.sep, "/")
                    files.append((full, base + "/" + rel))
        elif os.path.isfile(target):
            files.append((target, os.path.basename(target)))
        else:
            raise CliError("'{}' not found.".format(target))
    if not files:
        raise CliError("Nothing to upload.")
    return files


def content_type(path):
    ext = os.path.splitext(path)[1].lower()
    if ext in TEXT_TYPES:
        return TEXT_TYPES[ext]
    guessed, _ = mimetypes.guess_type(path)
    return guessed or "application/octet-stream"


def share_options(args):
    body = {}
    if args.slug:
        body["slug"] = args.slug
    if args.forever:
        body["days"] = "forever"
    elif args.days:
        body["days"] = args.days
    if args.password:
        body["password"] = args.password
    if args.title:
        body["title"] = args.title
    if args.team:
        body["team_id"] = args.team
        body["team_access"] = args.team_access or "edit"
    if getattr(args, "personal", False):
        body["personal"] = True
    return body


def cmd_upload(args):
    files = collect_files(args.paths)
    api = Api(args)
    body = share_options(args)
    if args.slug:
        body["reuse"] = True
    created = api.post("/api/shares", body)
    share = created["share"]
    fresh = not created.get("reused")
    uploaded = []
    try:
        for index, (full, rel) in enumerate(files, 1):
            size = os.path.getsize(full)
            print("Uploading {} of {}: {} ({})".format(index, len(files), rel, human_bytes(size)), file=sys.stderr)
            with open(full, "rb") as handle:
                result = api.request(
                    "PUT",
                    "/api/shares/{}/files/{}".format(q(share["slug"]), qpath(rel)),
                    data=handle,
                    headers={"Content-Type": content_type(full)},
                    length=size,
                )
            uploaded.append(result["url"])
    except CliError:
        if fresh and not uploaded:
            try:
                api.delete("/api/shares/" + q(share["slug"]))
            except CliError:
                pass
        raise
    detail = api.get("/api/shares/" + q(share["slug"]))["share"]
    expires = detail["expires_at"] or "never"
    emit(args, detail, ["Shared {} file{} as {}".format(len(uploaded), "" if len(uploaded) == 1 else "s", detail["url"]),
                        "Expires: " + expires] + ["- " + url for url in uploaded])


def cmd_link(args):
    api = Api(args)
    body = share_options(args)
    body["url"] = args.url
    share = api.post("/api/links", body)["share"]
    emit(args, share, [share["url"] + " -> " + share["target_url"], "Expires: " + (share["expires_at"] or "never")])


def share_line(share):
    what = "link -> " + (share.get("target_url") or "") if share["kind"] == "link" else "{} files, {}".format(share["file_count"], human_bytes(share["total_bytes"]))
    expires = share["expires_at"] or "never"
    owner = (share.get("owner") or {}).get("display_name") or ""
    team = share.get("team")
    extra = "  [team {} · {}]".format(team.get("name") or team["id"], team.get("access", "view")) if team else "  [personal]"
    return "{:<24} {:<30} expires {:<26} {}{}".format(share["slug"], what, expires, owner, extra)


def cmd_list(args):
    api = Api(args)
    params = {"limit": str(args.limit)}
    if args.all:
        params["scope"] = "all"
    elif args.team:
        params.update({"scope": "team", "team_id": args.team})
    elif args.teams:
        params["scope"] = "teams"
    elif args.bots:
        params["scope"] = "bots"
    if args.search:
        params["q"] = args.search
    data = api.get("/api/shares?" + urllib.parse.urlencode(params))
    lines = [share_line(s) for s in data["shares"]] or ["No live shares."]
    emit(args, data, lines)


def cmd_info(args):
    share = Api(args).get("/api/shares/" + q(args.slug))["share"]
    lines = [share["url"], "Kind: " + share["kind"], "Owner: " + (share["owner"].get("display_name") or share["owner"]["id"]),
             "Expires: " + (share["expires_at"] or "never"), "Password: " + ("yes" if share["has_password"] else "no"),
             "Shared with: " + sharing_label(share), "You can: " + ("manage" if share.get("can_manage") else "edit" if share.get("can_edit") else "view")]
    if share.get("target_url"):
        lines.append("Opens: " + share["target_url"])
    for f in share.get("files") or []:
        lines.append("- {}  ({})".format(f["url"], human_bytes(f["size"])))
    emit(args, share, lines)


def sharing_label(share):
    team = share.get("team")
    if not team:
        return "only you (personal)"
    return "team {} ({})".format(team.get("name") or team["id"], "can edit" if team.get("access") == "edit" else "view only")


def cmd_share(args):
    """Move a share to the team side.  The owner never changes."""
    api = Api(args)
    team = args.team
    if not team:
        teams = api.get("/api/teams")["teams"]
        if len(teams) != 1:
            raise CliError("Give --team TEAM_ID (fleet-share teams list)." if teams else "You are not in a team.  Create one with: fleet-share teams create NAME")
        team = teams[0]["id"]
    share = api.request("PATCH", "/api/shares/" + q(args.slug), {"team_id": team, "team_access": "view" if args.view else "edit"})["share"]
    emit(args, share, ["{} is shared with {}.  You still own it.".format(share["slug"], sharing_label(share))])


def cmd_unshare(args):
    share = Api(args).request("PATCH", "/api/shares/" + q(args.slug), {"team_id": None})["share"]
    emit(args, share, ["{} is personal again.".format(share["slug"])])


# ------------------------------------------------- MCP parity and file commands

def mcp_call(api, name, arguments):
    """One FleetLink MCP tool call, so this CLI can do anything the MCP server can."""
    body = {"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": name, "arguments": arguments}}
    reply = api.request("POST", "/mcp", body, headers={"MCP-Protocol-Version": "2025-06-18"})
    result = (reply or {}).get("result") or {}
    content = result.get("content") or [{}]
    text = content[0].get("text", "")
    if result.get("isError") or (reply or {}).get("error"):
        raise CliError(text or (reply.get("error") or {}).get("message") or "The tool call failed.")
    try:
        return json.loads(text)
    except ValueError:
        return {"text": text}


def parse_tool_args(args):
    out = {}
    if args.args_json:
        raw = args.args_json
        if raw.startswith("@"):
            with open(raw[1:], encoding="utf-8") as handle:
                raw = handle.read()
        out.update(json.loads(raw))
    for pair in args.arg or []:
        if "=" not in pair:
            raise CliError("Use --arg KEY=VALUE.")
        key, value = pair.split("=", 1)
        try:
            out[key] = json.loads(value)
        except ValueError:
            out[key] = value
    return out


def cmd_tools(args):
    api = Api(args)
    reply = api.request("POST", "/mcp", {"jsonrpc": "2.0", "id": 1, "method": "tools/list", "params": {}}, headers={"MCP-Protocol-Version": "2025-06-18"})
    tools = (reply.get("result") or {}).get("tools") or []
    emit(args, {"tools": tools}, ["{:<28} {}".format(t["name"], t.get("title") or "") for t in tools])


def cmd_tool(args):
    data = mcp_call(Api(args), args.name, parse_tool_args(args))
    print(json.dumps(data, indent=2))


def cmd_cat(args):
    """Print or save one file from a share you can see (yours, your team's, or your bots')."""
    data = mcp_call(Api(args), "fleetlink_read_file", {"slug": args.slug, "path": args.path})
    raw = base64.b64decode(data["content"]) if data.get("encoding") == "base64" else data.get("text", "").encode("utf-8")
    if args.output:
        with open(args.output, "wb") as handle:
            handle.write(raw)
        print("Saved {} ({})".format(args.output, human_bytes(len(raw))), file=sys.stderr)
    else:
        sys.stdout.buffer.write(raw)


def cmd_add(args):
    """Add or replace files in an existing share you can edit, without creating one."""
    api = Api(args)
    added = []
    for full, rel in collect_files(args.paths):
        target = args.path if args.path and len(args.paths) == 1 and os.path.isfile(args.paths[0]) else rel
        with open(full, "rb") as handle:
            result = api.request("PUT", "/api/shares/{}/files/{}".format(q(args.slug), qpath(target)), data=handle,
                                 headers={"Content-Type": content_type(full)}, length=os.path.getsize(full))
        added.append(result["url"])
    emit(args, {"urls": added}, ["- " + url for url in added])


def cmd_rm_file(args):
    data = Api(args).delete("/api/shares/{}/files/{}".format(q(args.slug), qpath(args.path)))
    emit(args, data, ["Deleted {}/{}".format(args.slug, args.path)])


def cmd_update(args):
    body = {}
    if args.title is not None:
        body["title"] = args.title or None
    if args.description is not None:
        body["description"] = args.description or None
    if args.url:
        body["url"] = args.url
    if args.rename:
        body["slug"] = args.rename
    if args.password is not None:
        body["password"] = args.password
    if args.no_password:
        body["password"] = None
    if args.team_access:
        body["team_access"] = args.team_access
    if not body:
        raise CliError("Nothing to change.  Use --title, --description, --url, --rename, --password, --no-password, or --team-access.")
    share = Api(args).patch("/api/shares/" + q(args.slug), body)["share"]
    emit(args, share, ["Updated {}".format(share["slug"])])


def cmd_bots(args):
    """Bots under your account:  list, add, rename, disable, enable, and their tokens."""
    api = Api(args)
    rest = args.rest
    if args.action == "list":
        data = api.get("/api/bots")
        lines = ["{:<24} {:<14} {:<8} {} shares, {} tokens".format(b["id"], b["seat"], b["status"], b["usage"]["shares"], b["token_count"]) for b in data["bots"]]
        if data.get("fleet_owner"):
            lines.insert(0, "You are the fleet owner.")
        emit(args, data, lines or ["No bots under your account."])
        return
    if not rest:
        raise CliError("fleet-share bots {} BOT ...  (BOT is a seat such as CODEX, or a user id)".format(args.action))
    bot = rest[0] if rest[0].startswith("usr_") else "usr_agent_" + rest[0].lower().replace("-", "_")
    if args.action == "add":
        data = api.post("/api/bots", {"seat": rest[0], **({"display_name": args.name} if args.name else {})})
        emit(args, data, ["Added {} ({})".format(data["bot"]["display_name"], data["bot"]["id"])])
    elif args.action in ("disable", "enable"):
        data = api.patch("/api/bots/" + q(bot), {"status": "disabled" if args.action == "disable" else "active"})
        emit(args, data, ["{} is {}".format(data["bot"]["display_name"], data["bot"]["status"])])
    elif args.action == "rename":
        if not args.name:
            raise CliError("fleet-share bots rename BOT --name NAME")
        data = api.patch("/api/bots/" + q(bot), {"display_name": args.name})
        emit(args, data, ["Renamed to {}".format(data["bot"]["display_name"])])
    elif args.action == "token":
        data = api.post("/api/bots/{}/tokens".format(q(bot)), {"name": args.name or "{} token".format(rest[0])})
        emit(args, data, ["Token for {} (shown once): {}".format(rest[0], data["token"])])
    elif args.action == "tokens":
        data = api.get("/api/bots/{}/tokens".format(q(bot)))
        emit(args, data, ["{}  {}  {}…  last used {}".format(t["id"], t["name"], t["prefix"], t["last_used_at"] or "never") for t in data["tokens"]] or ["No tokens."])
    elif args.action == "revoke":
        if len(rest) < 2:
            raise CliError("fleet-share bots revoke BOT TOKEN_ID")
        api.delete("/api/bots/{}/tokens/{}".format(q(bot), q(rest[1])))
        print("Revoked " + rest[1])


def cmd_upload_url(args):
    body = {"path": args.path}
    if args.max_mb:
        body["max_bytes"] = int(args.max_mb * 1024 * 1024)
    if args.ttl:
        body["ttl_seconds"] = args.ttl
    upload = Api(args).post("/api/shares/{}/upload-url".format(q(args.slug)), body)["upload"]
    emit(args, upload, [upload["upload_url"], "Works once until {}.  Upload with:".format(upload["expires_at"]), "  curl -fsS -T ./FILE '{}'".format(upload["upload_url"])])


def cmd_renew(args):
    body = {"days": args.days} if args.days else {}
    data = Api(args).post("/api/shares/{}/renew".format(q(args.slug)), body)
    share = data["share"]
    emit(args, data, ["{} now expires {}".format(share["slug"], share["expires_at"] or "never")])


def cmd_delete(args):
    if not args.yes and sys.stdin.isatty():
        answer = input("Delete {} and all of its files? [y/N] ".format(args.slug))
        if answer.strip().lower() not in ("y", "yes"):
            raise CliError("Cancelled.")
    data = Api(args).delete("/api/shares/" + q(args.slug))
    emit(args, data, ["Deleted {}".format(data.get("slug", args.slug))])


def cmd_whoami(args):
    data = Api(args).get("/api/me")
    user, usage, quotas = data["user"], data["usage"], data["quotas"]
    quota = human_bytes(quotas["storage_bytes"]) if quotas["storage_bytes"] is not None else "unlimited"
    lines = ["{} ({}){}".format(user["display_name"], user["role"], " <{}>".format(user["email"]) if user.get("email") else ""),
             "Signed in with: " + data["auth"]["kind"],
             "Storage: {} of {} across {} shares".format(human_bytes(usage["bytes"]), quota, usage["shares"])]
    emit(args, data, lines)


def cmd_login(args):
    token = args.token or os.environ.get("FLEETLINK_TOKEN") or getpass.getpass("API token (input hidden): ")
    token = token.strip()
    if not token.startswith("fla_"):
        raise CliError("That does not look like a FleetLink API token (fla_…).")
    args.token = token
    me = Api(args).get("/api/me")
    path = credentials_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, stat.S_IRUSR | stat.S_IWUSR)
    with os.fdopen(fd, "w") as handle:
        handle.write("FLEETLINK_TOKEN=" + token + "\n")
    os.chmod(path, 0o600)
    print("Signed in as {}.  Saved to {}.".format(me["user"]["display_name"], path))


def cmd_logout(args):
    path = credentials_path()
    if os.path.exists(path):
        os.remove(path)
        print("Removed " + path + ".  The token itself still works until you revoke it on the dashboard.")
    else:
        print("No saved login.")


def cmd_tokens(args):
    api = Api(args)
    if args.action == "list":
        data = api.get("/api/tokens")
        lines = ["{:<14} {:<24} {}{}".format(t["id"], t["name"], t["prefix"] + "…", "  team " + t["team_name"] if t.get("team_name") else "") for t in data["tokens"]]
        emit(args, data, lines + ["{} of {} tokens in use.".format(len(data["tokens"]), data["quota"])])
    elif args.action == "create":
        if not args.name:
            raise CliError("Name the token: fleet-share tokens create NAME")
        body = {"name": args.name, "allow_links": not args.no_links}
        if args.team:
            body["team_id"] = args.team
        if args.max_days:
            body["max_days"] = args.max_days
        if args.max_file_mb:
            body["max_file_mb"] = args.max_file_mb
        if args.expires_days:
            body["expires_in_days"] = args.expires_days
        data = api.post("/api/tokens", body)
        emit(args, data, ["Created {} ({}).  Copy the token now; it is not shown again:".format(data["api_token"]["name"], data["api_token"]["id"]), data["token"]])
    elif args.action == "revoke":
        if not args.name:
            raise CliError("Give the token id: fleet-share tokens revoke ID")
        api.delete("/api/tokens/" + q(args.name))
        print("Revoked " + args.name)


def cmd_teams(args):
    api = Api(args)
    if args.action == "list":
        data = api.get("/api/teams")
        lines = []
        for team in data["teams"]:
            lines.append("{}  {}  (you: {}, {} members, {} live shares)".format(team["id"], team["name"], team["my_role"], len(team["members"]), team["share_count"]))
        emit(args, data, lines or ["You are not in a team."])
        return
    if args.action == "create":
        team = api.post("/api/teams", {"name": " ".join(args.rest)})["team"]
        emit(args, team, ["Created team {} ({})".format(team["name"], team["id"])])
    elif args.action == "add":
        if len(args.rest) < 2:
            raise CliError("fleet-share teams add TEAM_ID EMAIL [--role admin]")
        team = api.post("/api/teams/{}/members".format(q(args.rest[0])), {"email": args.rest[1], "role": args.role or "member"})["team"]
        emit(args, team, ["Added {} to {}".format(args.rest[1], team["name"])])
    elif args.action == "remove":
        if len(args.rest) < 2:
            raise CliError("fleet-share teams remove TEAM_ID USER_ID")
        api.delete("/api/teams/{}/members/{}".format(q(args.rest[0]), q(args.rest[1])))
        print("Removed.")
    elif args.action == "leave":
        if not args.rest:
            raise CliError("fleet-share teams leave TEAM_ID")
        me = api.get("/api/me")["user"]["id"]
        api.delete("/api/teams/{}/members/{}".format(q(args.rest[0]), q(me)))
        print("Left the team.")


def cmd_admin(args):
    api = Api(args)
    rest = args.rest
    if args.action == "stats":
        data = api.get("/api/admin/stats")
        emit(args, data, ["Live shares: {} ({}).  Teams: {}.  Open invites: {}.  Sign-up: {}.".format(
            data["shares"]["count"], human_bytes(data["shares"]["bytes"]), data["teams"], data["active_invites"], data["settings"]["signup_mode"])])
    elif args.action == "users":
        path = "/api/admin/users" + ("?q=" + q(args.search) if args.search else "")
        data = api.get(path)
        lines = ["{:<26} {:<20} {:<6} {:<9} {} shares, {}".format(u["id"], u["display_name"][:20], u["role"], u["status"], u["usage"]["shares"], human_bytes(u["usage"]["bytes"])) for u in data["users"]]
        emit(args, data, lines)
    elif args.action == "user":
        if len(rest) < 2 or rest[0] not in ("set", "delete", "show"):
            raise CliError("fleet-share admin user show|set|delete USER_ID [--role R] [--status S] [--storage-gb N] [--token-quota N]")
        verb, user_id = rest[0], rest[1]
        if verb == "show":
            data = api.get("/api/admin/users/" + q(user_id))
            emit(args, data, [json.dumps(data["user"], indent=2)])
        elif verb == "delete":
            api.delete("/api/admin/users/" + q(user_id))
            print("Deleted " + user_id)
        else:
            body = {}
            if args.role:
                body["role"] = args.role
            if args.status:
                body["status"] = args.status
            if args.storage_gb is not None:
                body["storage_quota_bytes"] = None if args.storage_gb < 0 else int(args.storage_gb * 1024 ** 3)
            if args.token_quota is not None:
                body["token_quota"] = None if args.token_quota < 0 else args.token_quota
            if not body:
                raise CliError("Nothing to change.")
            data = api.patch("/api/admin/users/" + q(user_id), body)
            emit(args, data, ["Updated {}".format(data["user"]["display_name"])])
    elif args.action == "invite":
        body = {"role": args.role or "user", "max_uses": args.uses, "expires_in_days": args.days_valid}
        if args.note:
            body["note"] = args.note
        if args.team:
            body["team_id"] = args.team
        data = api.post("/api/admin/invites", body)
        link = "{}/login?invite={}".format(api.base, q(data["code"]))
        emit(args, data, ["Invite code (not shown again): " + data["code"], "Sign-up link: " + link])
    elif args.action == "invites":
        data = api.get("/api/admin/invites")
        lines = ["{:<14} {}-…  {:<7} {:<6} {} of {} used  expires {}".format(i["id"], i["prefix"], i["state"], i["role"], i["uses"], i["max_uses"], i["expires_at"]) for i in data["invites"]]
        emit(args, data, lines or ["No invites."])
    elif args.action == "revoke-invite":
        if not rest:
            raise CliError("fleet-share admin revoke-invite INVITE_ID")
        api.delete("/api/admin/invites/" + q(rest[0]))
        print("Revoked " + rest[0])
    elif args.action == "settings":
        if rest:
            values = {}
            for pair in rest:
                if "=" not in pair:
                    raise CliError("Use KEY=VALUE, or KEY= to clear a saved value.")
                key, value = pair.split("=", 1)
                values[key] = None if value == "" else (int(value) if value.isdigit() else value)
            data = api.put_json("/api/admin/settings", {"values": values})
        else:
            data = api.get("/api/admin/settings")
        emit(args, data, ["{} = {}  ({})".format(f["key"], ",".join(f["value"]) if isinstance(f["value"], list) else f["value"], f["source"]) for f in data["fields"]])
    elif args.action == "sweep":
        data = api.post("/api/admin/sweep")
        emit(args, data, [json.dumps(data["report"])])
    elif args.action == "fleet":
        if rest and rest[0] == "claim":
            data = api.post("/api/admin/fleet/claim", {})
            emit(args, data, ["You are the fleet owner.  {} bots moved under your account.".format(data["bots"])])
        else:
            data = api.get("/api/admin/fleet")
            owner = data.get("owner")
            emit(args, data, ["Fleet owner: {}.  {} bots, {} without a manager.".format(owner["display_name"] if owner else "none", data["bots"], data["unmanaged"])])
    elif args.action == "teams":
        if rest and rest[0] == "join":
            if len(rest) < 2:
                raise CliError("fleet-share admin teams join TEAM_ID")
            data = api.post("/api/admin/teams/{}/join".format(q(rest[1])), {})
            emit(args, data, ["Joined {} as owner".format(rest[1])])
        else:
            data = api.get("/api/admin/teams")
            emit(args, data, ["{:<16} {:<24} {} members, {} shares{}".format(t["id"], t["name"], t["members"], t["shares"], "  (you: {})".format(t["my_role"]) if t["my_role"] else "") for t in data["teams"]])


# --------------------------------------------------------------- skill install

def repo_root():
    here = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    for candidate in (here, os.environ.get("FLEETLINK_REPO_ROOT", "")):
        if candidate and os.path.isfile(os.path.join(candidate, "scripts/install-skill.sh")) and os.path.isfile(os.path.join(candidate, "skills/fleetlink/SKILL.md")):
            return candidate
    return None


def sha256_file(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(65536), b""):
            digest.update(chunk)
    return digest.hexdigest()


def fetch(url, dest):
    try:
        with urllib.request.urlopen(url, timeout=60) as res, open(dest, "wb") as out:
            out.write(res.read())
    except (urllib.error.URLError, OSError) as err:
        raise CliError("Could not download {} ({}).  Run fleet-share from a FleetLink checkout, or set FLEETLINK_SKILL_RAW_BASE.".format(url, err))


def require_hash(path, expected, label):
    expected = (expected or "").strip().lower()
    if not expected:
        raise CliError("Refusing to run: no pinned SHA-256 for {}.".format(label))
    actual = sha256_file(path)
    if actual != expected:
        os.remove(path)
        raise CliError("Refusing to run: {} hash mismatch.\nexpected {}\nactual   {}".format(label, expected, actual))


def cmd_skill(args):
    extra = args.rest
    root = repo_root()
    if root:
        return subprocess.call(["bash", os.path.join(root, "scripts/install-skill.sh")] + extra)
    home = os.path.expanduser("~")
    if not home or home == "/":
        raise CliError("Refusing to download the FleetLink skill: HOME is unset or /.")
    pin = os.environ.get("FLEETLINK_SKILL_GIT_SHA") or FLEETLINK_PINNED_GIT_SHA_DEFAULT
    base = (os.environ.get("FLEETLINK_SKILL_RAW_BASE") or "https://raw.githubusercontent.com/Simple-With-Us/FleetLink/" + pin).rstrip("/")
    cache = os.environ.get("FLEETLINK_SKILL_CACHE") or os.path.join(home, ".cache", "fleetlink")
    os.makedirs(os.path.join(cache, "skills", "fleetlink"), exist_ok=True)
    os.makedirs(os.path.join(cache, "scripts"), exist_ok=True)
    skill = os.path.join(cache, "skills", "fleetlink", "SKILL.md")
    installer = os.path.join(cache, "scripts", "install-skill.sh")
    fetch(base + "/skills/fleetlink/SKILL.md", skill)
    fetch(base + "/scripts/install-skill.sh", installer)
    require_hash(skill, os.environ.get("FLEETLINK_SKILL_MD_SHA256") or FLEETLINK_SKILL_MD_SHA256_DEFAULT, "SKILL.md")
    require_hash(installer, os.environ.get("FLEETLINK_INSTALLER_SHA256") or FLEETLINK_INSTALLER_SHA256_DEFAULT, "install-skill.sh")
    os.chmod(installer, 0o755)
    return subprocess.call(["bash", installer] + extra)


# ---------------------------------------------------------------------- parser

COMMANDS = {"upload", "link", "list", "ls", "info", "cat", "add", "rm-file", "update", "bots", "tools", "tool", "share", "unshare", "personal", "upload-url", "renew", "delete", "rm", "whoami", "login", "logout", "tokens", "teams", "admin", "skill", "help", "version"}


def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--domain", help="FleetLink base URL (default {} or FLEETLINK_DOMAIN)".format(DEFAULT_DOMAIN))
    common.add_argument("--token", help="API token for this call (prefer FLEETLINK_TOKEN or `fleet-share login`)")
    common.add_argument("--operator", action="store_true", help="use the operator secret (FLEET_ADMIN_SECRET) even if a token is set")
    common.add_argument("--json", action="store_true", help="print JSON")

    shareopts = argparse.ArgumentParser(add_help=False)
    shareopts.add_argument("--slug", "--id", dest="slug", help="share name (default: random); reuses a share you manage")
    shareopts.add_argument("--days", help="lifetime in days")
    shareopts.add_argument("--forever", action="store_true", help="never expire (admins)")
    shareopts.add_argument("--password", help="require a password to open")
    shareopts.add_argument("--title", help="title shown on the share page")
    shareopts.add_argument("--team", help="team id to share it with (default: personal)")
    shareopts.add_argument("--team-access", choices=["edit", "view"], help="what team members may do (default edit)")
    shareopts.add_argument("--personal", action="store_true", help="keep a bot's new share out of the Fleet team")

    parser = argparse.ArgumentParser(prog="fleet-share", description="Share files and short links on FleetLink.", parents=[common])
    sub = parser.add_subparsers(dest="command")

    p = sub.add_parser("upload", parents=[common, shareopts], help="upload files and folders as one share")
    p.add_argument("paths", nargs="+")
    p.add_argument("--agent", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--preview", help=argparse.SUPPRESS)
    p.set_defaults(func=cmd_upload)

    p = sub.add_parser("link", parents=[common, shareopts], help="make a short link")
    p.add_argument("url")
    p.set_defaults(func=cmd_link)

    p = sub.add_parser("list", aliases=["ls"], parents=[common], help="list your live shares")
    p.add_argument("--team", help="shares in this team")
    p.add_argument("--teams", action="store_true", help="shares in all your teams")
    p.add_argument("--all", action="store_true", help="every share (admins)")
    p.add_argument("--bots", action="store_true", help="shares of bots you manage")
    p.add_argument("--search")
    p.add_argument("--limit", type=int, default=50)
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("info", parents=[common], help="details and files of one share")
    p.add_argument("slug")
    p.set_defaults(func=cmd_info)

    p = sub.add_parser("cat", parents=[common], help="print or save one file from a share you can see")
    p.add_argument("slug")
    p.add_argument("path")
    p.add_argument("-o", "--output", help="save to this file instead of printing")
    p.set_defaults(func=cmd_cat)

    p = sub.add_parser("add", parents=[common], help="add or replace files in a share you can edit")
    p.add_argument("slug")
    p.add_argument("paths", nargs="+")
    p.add_argument("--path", help="path inside the share, for a single file")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("rm-file", parents=[common], help="delete one file from a share you can edit")
    p.add_argument("slug")
    p.add_argument("path")
    p.set_defaults(func=cmd_rm_file)

    p = sub.add_parser("update", parents=[common], help="change a share's title, description, link, name, password, or team access")
    p.add_argument("slug")
    p.add_argument("--title")
    p.add_argument("--description")
    p.add_argument("--url", help="new destination for a short link")
    p.add_argument("--rename", help="new share name")
    p.add_argument("--password")
    p.add_argument("--no-password", action="store_true")
    p.add_argument("--team-access", choices=["edit", "view"])
    p.set_defaults(func=cmd_update)

    p = sub.add_parser("bots", parents=[common], help="bots under your account and their tokens")
    p.add_argument("action", choices=["list", "add", "rename", "disable", "enable", "token", "tokens", "revoke"])
    p.add_argument("rest", nargs="*")
    p.add_argument("--name", help="display name, or a token's name")
    p.set_defaults(func=cmd_bots)

    p = sub.add_parser("tools", parents=[common], help="list the FleetLink MCP tools this credential can call")
    p.set_defaults(func=cmd_tools)

    p = sub.add_parser("tool", parents=[common], help="call any FleetLink MCP tool by name (full MCP parity)")
    p.add_argument("name")
    p.add_argument("--arg", action="append", help="KEY=VALUE (VALUE parsed as JSON when it can be)")
    p.add_argument("--args-json", help="JSON object, or @file")
    p.set_defaults(func=cmd_tool)

    p = sub.add_parser("share", parents=[common], help="share one of your shares with a team (you keep ownership)")
    p.add_argument("slug")
    p.add_argument("--team", help="team id (default: your only team)")
    access = p.add_mutually_exclusive_group()
    access.add_argument("--edit", action="store_true", help="members can add and change files (default)")
    access.add_argument("--view", action="store_true", help="members can only view")
    p.set_defaults(func=cmd_share)

    p = sub.add_parser("unshare", aliases=["personal"], parents=[common], help="take a share out of its team")
    p.add_argument("slug")
    p.set_defaults(func=cmd_unshare)

    p = sub.add_parser("upload-url", parents=[common], help="one-time URL to curl a file into a share")
    p.add_argument("slug")
    p.add_argument("path", help="path inside the share")
    p.add_argument("--max-mb", type=float)
    p.add_argument("--ttl", type=int, help="seconds, 30 to 1800 (default 900)")
    p.set_defaults(func=cmd_upload_url)

    p = sub.add_parser("renew", parents=[common], help="extend a share")
    p.add_argument("slug")
    p.add_argument("--days")
    p.set_defaults(func=cmd_renew)

    p = sub.add_parser("delete", aliases=["rm"], parents=[common], help="delete a share")
    p.add_argument("slug")
    p.add_argument("-y", "--yes", action="store_true")
    p.set_defaults(func=cmd_delete)

    p = sub.add_parser("whoami", parents=[common], help="who this credential acts as")
    p.set_defaults(func=cmd_whoami)
    p = sub.add_parser("login", parents=[common], help="save an API token for later commands")
    p.set_defaults(func=cmd_login)
    p = sub.add_parser("logout", parents=[common], help="forget the saved token")
    p.set_defaults(func=cmd_logout)

    p = sub.add_parser("tokens", parents=[common], help="list, create, or revoke your API tokens")
    p.add_argument("action", choices=["list", "create", "revoke"])
    p.add_argument("name", nargs="?")
    p.add_argument("--team")
    p.add_argument("--max-days", type=float)
    p.add_argument("--max-file-mb", type=float)
    p.add_argument("--expires-days", type=int)
    p.add_argument("--no-links", action="store_true")
    p.set_defaults(func=cmd_tokens)

    p = sub.add_parser("teams", parents=[common], help="list, create, and manage teams")
    p.add_argument("action", choices=["list", "create", "add", "remove", "leave"])
    p.add_argument("rest", nargs="*")
    p.add_argument("--role", choices=["member", "admin"])
    p.set_defaults(func=cmd_teams)

    p = sub.add_parser("admin", parents=[common], help="admin tools")
    p.add_argument("action", choices=["stats", "users", "user", "invite", "invites", "revoke-invite", "settings", "sweep", "fleet", "teams"])
    p.add_argument("rest", nargs="*")
    p.add_argument("--search")
    p.add_argument("--role", choices=["user", "admin"])
    p.add_argument("--status", choices=["active", "disabled"])
    p.add_argument("--storage-gb", type=float, help="per-person storage quota; negative clears it")
    p.add_argument("--token-quota", type=int, help="per-person token quota; negative clears it")
    p.add_argument("--uses", type=int, default=1)
    p.add_argument("--days-valid", type=int, default=14)
    p.add_argument("--note")
    p.add_argument("--team")
    p.set_defaults(func=cmd_admin)

    p = sub.add_parser("skill", help="install or update the FleetLink agent skill")
    p.add_argument("action", choices=["install", "update"])
    p.add_argument("rest", nargs=argparse.REMAINDER)
    p.set_defaults(func=cmd_skill)
    return parser


def main(argv):
    if argv and argv[0] in ("version", "--version"):
        print("fleet-share " + VERSION)
        return 0
    if argv and argv[0] == "help":
        argv = ["--help"]
    # Bare paths mean upload, as before: `fleet-share notes.md`.
    first = next((a for a in argv if not a.startswith("-")), None)
    if first is not None and first not in COMMANDS:
        argv = ["upload"] + argv
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        parser.print_help()
        return 1
    for attr in ("token", "operator", "agent", "json", "domain"):
        if not hasattr(args, attr):
            setattr(args, attr, None)
    try:
        result = args.func(args)
        return result if isinstance(result, int) else 0
    except CliError as err:
        print("Error: {}".format(err), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
