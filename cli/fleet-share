#!/bin/bash
set -e

mime_of() {
  local path="$1"
  local mt=""
  if command -v file >/dev/null 2>&1; then
    mt=$(file -b --mime-type "$path" 2>/dev/null || true)
  fi
  if [ -z "$mt" ] || [ "$mt" = "inode/x-empty" ]; then
    case "${path##*.}" in
      md) mt="text/markdown; charset=utf-8" ;;
      txt|log) mt="text/plain; charset=utf-8" ;;
      html|htm) mt="text/html; charset=utf-8" ;;
      json) mt="application/json; charset=utf-8" ;;
      png) mt="image/png" ;;
      jpg|jpeg) mt="image/jpeg" ;;
      gif) mt="image/gif" ;;
      webp) mt="image/webp" ;;
      svg) mt="image/svg+xml" ;;
      pdf) mt="application/pdf" ;;
      zip) mt="application/zip" ;;
      *) mt="application/octet-stream" ;;
    esac
  fi
  printf '%s' "$mt"
}

usage() {
  cat <<'EOF'
Usage: fleet-share [--domain <url>] [--id <hash> | --slug <name>] [--password <pass>] [--preview <image>] [--agent] [--days <N> | --forever] <file-or-dir> [file-or-dir ...]
       fleet-share skill install|update [--check] [--copy] [--copy-targets-only]

Auth is read from the first existing file among ~/.secrets/fleet-link-auth.env,
~/.secrets/fleet-share-auth.env, and the other paths documented in
skills/fleetlink/SKILL.md.  The value is never printed.
EOF
}

fleet_share_realpath() {
  if python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1" 2>/dev/null; then
    return 0
  fi
  if readlink -f "$1" >/dev/null 2>&1; then
    readlink -f "$1"
    return 0
  fi
  printf '%s\n' "$1"
}

fleet_share_repo_root() {
  local script_path script_dir candidate
  script_path=$(fleet_share_realpath "$0")
  script_dir=$(dirname -- "$script_path")
  candidate=$(dirname -- "$script_dir")
  if [ -f "$candidate/scripts/install-skill.sh" ] && [ -f "$candidate/skills/fleetlink/SKILL.md" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  if [ -n "${FLEETLINK_REPO_ROOT:-}" ] && [ -f "${FLEETLINK_REPO_ROOT}/scripts/install-skill.sh" ] && [ -f "${FLEETLINK_REPO_ROOT}/skills/fleetlink/SKILL.md" ]; then
    printf '%s\n' "${FLEETLINK_REPO_ROOT}"
    return 0
  fi
  return 1
}

fleet_share_curl() {
  local url=$1 dest=$2
  if ! curl -fsSL "$url" -o "$dest"; then
    echo "Could not download $url" >&2
    echo "Run fleet-share from a FleetLink checkout, or set FLEETLINK_SKILL_RAW_BASE to a raw base URL that serves skills/fleetlink/SKILL.md and scripts/install-skill.sh." >&2
    exit 1
  fi
}

fleet_share_fetch_and_install() {
  local base cache
  if [ -z "${HOME:-}" ] || [ "$HOME" = "/" ]; then
    echo "Refusing to download the FleetLink skill: HOME is unset or /." >&2
    exit 1
  fi
  base=${FLEETLINK_SKILL_RAW_BASE:-https://raw.githubusercontent.com/Simple-With-Us/FleetLink/main}
  base=${base%/}
  cache=${FLEETLINK_SKILL_CACHE:-$HOME/.cache/fleetlink}
  mkdir -p "$cache/skills/fleetlink" "$cache/scripts"
  fleet_share_curl "$base/skills/fleetlink/SKILL.md" "$cache/skills/fleetlink/SKILL.md"
  fleet_share_curl "$base/scripts/install-skill.sh" "$cache/scripts/install-skill.sh"
  chmod +x "$cache/scripts/install-skill.sh"
  bash "$cache/scripts/install-skill.sh" "$@"
}

fleet_share_skill() {
  local sub repo
  sub=${1:-}
  if [ "$sub" != "install" ] && [ "$sub" != "update" ]; then
    echo "Usage: fleet-share skill install|update [--check] [--copy] [--copy-targets-only]" >&2
    exit 1
  fi
  shift
  if repo=$(fleet_share_repo_root); then
    bash "$repo/scripts/install-skill.sh" "$@"
    return 0
  fi
  fleet_share_fetch_and_install "$@"
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "help" ]; then
  usage
  exit 0
fi

if [ "${1:-}" = "skill" ]; then
  shift
  fleet_share_skill "$@"
  exit 0
fi

DOMAIN="${FLEETLINK_DOMAIN:-https://fleetlink.online}"

# Resolve auth credentials from standard secrets paths
AUTH_FILE=""
for f in "$HOME/.secrets/fleet-link-auth.env" "$HOME/.secrets/fleet-share-auth.env" "/Users/jay/.secrets/fleet-link-auth.env" "/home/box/.secrets/fleet-share-auth.env" "./fleet-link-auth.env" "./.fleet-link-auth.env"; do
  if [ -f "$f" ]; then
    AUTH_FILE="$f"
    break
  fi
done

ID=""
SLUG=""
DAYS=""
FOREVER=0
PASSWORD=""
PREVIEW=""
USE_AGENT=0

while [[ $# -gt 0 ]]; do
  case $1 in
    --domain)
      DOMAIN="$2"
      shift 2
      ;;
    --id)
      ID="$2"
      shift 2
      ;;
    --slug)
      SLUG="$2"
      shift 2
      ;;
    --days)
      DAYS="$2"
      shift 2
      ;;
    --password)
      PASSWORD="$2"
      shift 2
      ;;
    --preview)
      PREVIEW="$2"
      shift 2
      ;;
    --agent)
      USE_AGENT=1
      shift
      ;;
    --forever)
      FOREVER=1
      shift
      ;;
    *)
      break
      ;;
  esac
done

if [ "$#" -eq 0 ]; then
  usage
  exit 1
fi

if [ -z "$AUTH_FILE" ]; then
  echo "❌ Error: Could not find authentication file (fleet-link-auth.env)."
  echo "Please place your credentials at ~/.secrets/fleet-link-auth.env"
  exit 1
fi

if [ "$USE_AGENT" -eq 1 ]; then
  AUTH_HEADER_NAME="X-Fleet-Agent"
  AUTH_SECRET=$(grep -E '^(FLEET_AGENT_SECRET|AGENT_SECRET)=' "$AUTH_FILE" | head -n1 | cut -d '=' -f2- | tr -d '"' | tr -d "'")
else
  AUTH_HEADER_NAME="X-Fleet-Admin"
  AUTH_SECRET=$(grep -E '^(FLEET_ADMIN_SECRET|ADMIN_SECRET|FLEET_AUTH_SECRET|AUTH_SECRET)=' "$AUTH_FILE" | head -n1 | cut -d '=' -f2- | tr -d '"' | tr -d "'")
fi

if [ -z "$AUTH_SECRET" ]; then
  echo "❌ Error: Could not read authentication token from $AUTH_FILE."
  exit 1
fi

EXPIRE_HEADER="X-Expire-Days: 3"
if [ "$FOREVER" -eq 1 ]; then
  EXPIRE_HEADER="X-Expire-Days: forever"
elif [ -n "$DAYS" ]; then
  EXPIRE_HEADER="X-Expire-Days: $DAYS"
fi

MAX_FILE_BYTES=$((100 * 1024 * 1024))   # 100MB
MAX_TOTAL_BYTES=$((500 * 1024 * 1024))  # 500MB

# Pre-validate file sizes and calculate total
TOTAL_BYTES=0
for TARGET in "$@"; do
  TARGET="${TARGET%/}"
  if [ ! -e "$TARGET" ]; then
    echo "Error: '$TARGET' not found, aborting."
    exit 1
  fi
  if [ -d "$TARGET" ]; then
    while read -r FILE; do
      FSIZE=$(stat -f%z "$FILE" 2>/dev/null || stat -c%s "$FILE" 2>/dev/null || echo 0)
      if [ "$FSIZE" -gt "$MAX_FILE_BYTES" ]; then
        SIZE_MB=$((FSIZE / 1024 / 1024))
        echo "❌ Upload rejected: '$FILE' is ${SIZE_MB}MB, exceeding the 100MB per-file limit."
        exit 1
      fi
      TOTAL_BYTES=$((TOTAL_BYTES + FSIZE))
    done < <(find "$TARGET" -type f)
  else
    FSIZE=$(stat -f%z "$TARGET" 2>/dev/null || stat -c%s "$TARGET" 2>/dev/null || echo 0)
    if [ "$FSIZE" -gt "$MAX_FILE_BYTES" ]; then
      SIZE_MB=$((FSIZE / 1024 / 1024))
      echo "❌ Upload rejected: '$TARGET' is ${SIZE_MB}MB, exceeding the 100MB per-file limit."
      exit 1
    fi
    TOTAL_BYTES=$((TOTAL_BYTES + FSIZE))
  fi
done

if [ "$TOTAL_BYTES" -gt "$MAX_TOTAL_BYTES" ]; then
  TOTAL_MB=$((TOTAL_BYTES / 1024 / 1024))
  echo "❌ Upload rejected: Total batch size is ${TOTAL_MB}MB, exceeding the 500MB total limit."
  exit 1
fi

upload_file() {
  local TARGET_URL="$1"
  local FILE_PATH="$2"
  local CONTENT_TYPE="$3"

  local EXTRA_HEADERS=()
  if [ -n "$PASSWORD" ]; then
    EXTRA_HEADERS+=(-H "X-Fleet-Password: $PASSWORD")
  fi
  if [ -n "$PREVIEW" ]; then
    EXTRA_HEADERS+=(-H "X-Fleet-Preview: $PREVIEW")
  fi

  local RESPONSE
  RESPONSE=$(curl -s -w "\n%{http_code}" -X PUT "$TARGET_URL" \
       -T "$FILE_PATH" \
       -H "${AUTH_HEADER_NAME}: ${AUTH_SECRET}" \
       -H "Content-Type: $CONTENT_TYPE" \
       -H "$EXPIRE_HEADER" \
       "${EXTRA_HEADERS[@]}")

  local HTTP_CODE
  HTTP_CODE=$(echo "$RESPONSE" | tail -n1)
  local BODY
  BODY=$(echo "$RESPONSE" | sed '$d')

  if [ "$HTTP_CODE" -lt 200 ] || [ "$HTTP_CODE" -ge 300 ]; then
    echo ""
    echo "❌ Upload rejected (HTTP $HTTP_CODE):"
    echo "$BODY"
    exit 1
  fi
}

if [ -n "$SLUG" ]; then
  if [ "$#" -eq 1 ] && [ -f "$1" ]; then
    TARGET="$1"
    TARGET="${TARGET%/}"
    EXT="${TARGET##*.}"
    CTYPE=$(mime_of "$TARGET")
    if [ "$EXT" = "md" ]; then CTYPE="text/markdown; charset=utf-8"; fi
    if [ "$EXT" = "txt" ]; then CTYPE="text/plain; charset=utf-8"; fi
    if [ "$EXT" = "html" ]; then CTYPE="text/html; charset=utf-8"; fi
    if [ "$EXT" = "json" ]; then CTYPE="application/json; charset=utf-8"; fi
    
    echo "Uploading '$TARGET' as custom slug '/$SLUG'..."
    upload_file "$DOMAIN/$SLUG" "$TARGET" "$CTYPE"
    
    echo ""
    echo "✅ Shared successfully!"
    echo "Public URL: $DOMAIN/$SLUG"
    exit 0
  else
    SHARE_ID="$SLUG"
  fi
elif [ -n "$ID" ]; then
  SHARE_ID="$ID"
else
  SHARE_ID=$(openssl rand -hex 3)
fi

BASE_URL="$DOMAIN/$SHARE_ID"
echo "Uploading to batch: $SHARE_ID..."

for TARGET in "$@"; do
  TARGET="${TARGET%/}"
  if [ ! -e "$TARGET" ]; then
    echo "Error: '$TARGET' not found, skipping."
    continue
  fi
  
  if [ -d "$TARGET" ]; then
    find "$TARGET" -type f | while read -r FILE; do
      REL_PATH=${FILE#"$TARGET"/}
      CTYPE=$(mime_of "$FILE")
      EXT="${FILE##*.}"
      if [ "$EXT" = "md" ]; then CTYPE="text/markdown; charset=utf-8"; fi
      if [ "$EXT" = "txt" ]; then CTYPE="text/plain; charset=utf-8"; fi
      if [ "$EXT" = "html" ]; then CTYPE="text/html; charset=utf-8"; fi
      if [ "$EXT" = "json" ]; then CTYPE="application/json; charset=utf-8"; fi
      
      echo "Uploading '$FILE'..."
      upload_file "$DOMAIN/$SHARE_ID/$(basename "$TARGET")/$REL_PATH" "$FILE" "$CTYPE"
    done
  else
    FILENAME=$(basename -- "$TARGET")
    EXT="${FILENAME##*.}"
    CTYPE=$(mime_of "$TARGET")
    if [ "$EXT" = "md" ]; then CTYPE="text/markdown; charset=utf-8"; fi
    if [ "$EXT" = "txt" ]; then CTYPE="text/plain; charset=utf-8"; fi
    if [ "$EXT" = "html" ]; then CTYPE="text/html; charset=utf-8"; fi
    if [ "$EXT" = "json" ]; then CTYPE="application/json; charset=utf-8"; fi
    
    echo "Uploading '$TARGET'..."
    upload_file "$DOMAIN/$SHARE_ID/$FILENAME" "$TARGET" "$CTYPE"
  fi
done

echo ""
echo "✅ Shared successfully!"
echo "Base Directory URL: $BASE_URL/"
echo "Direct links:"
for TARGET in "$@"; do
  TARGET="${TARGET%/}"
  if [ -e "$TARGET" ]; then
    echo "- $BASE_URL/$(basename "$TARGET")"
  fi
done
echo ""
