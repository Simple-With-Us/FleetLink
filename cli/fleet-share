# BEGIN shared private-file fleet bearer client
# Functional body is byte-identical to AFC fleet_bearer.py, from ENDPOINT onward.
# Imports are at module top because this file is also the standalone CLI.
ENDPOINT = "https://agents.simplewithus.com/mcp"
MAX_BYTES = 4_000_000
TOKEN = re.compile(r"(?:sbt_([a-z][a-z0-9-]{1,19})|gbb_([a-z][a-z0-9]{1,19}))_([A-Za-z0-9_-]{43})")


class FleetError(Exception):
    def __init__(self, code, message):
        self.code = code
        super().__init__(message)


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


def private_bearer(path):
    """Open once, without symlink following; never disclose content in errors."""
    try:
        if not isinstance(path, (str, os.PathLike)) or not str(path).strip():
            raise ValueError
        path = Path(path).expanduser().absolute()
        # Walk with directory descriptors, not lstat-then-open: replacement of
        # an ancestor must not redirect the credential read through a symlink.
        directory = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
        try:
            for component in path.parts[1:-1]:
                child = os.open(
                    component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory
                )
                os.close(directory)
                directory = child
                info = os.fstat(directory)
                root_sticky = info.st_uid in (0, os.getuid()) and bool(info.st_mode & stat.S_ISVTX)
                if (info.st_mode & 0o022 and not root_sticky) or info.st_uid not in (
                    0,
                    os.getuid(),
                ):
                    raise ValueError
            fd = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
            with os.fdopen(fd, "rb") as handle:
                info = os.fstat(handle.fileno())
                if (
                    not stat.S_ISREG(info.st_mode)
                    or info.st_uid != os.getuid()
                    or stat.S_IMODE(info.st_mode) not in (0o400, 0o600)
                    or info.st_nlink != 1
                    or info.st_size > 256
                ):
                    raise ValueError
                raw = handle.read(257)
        finally:
            os.close(directory)
        value = raw.decode("ascii")
        if value[-1:] == "\n":
            value = value[:-1]
        match = TOKEN.fullmatch(value)
        if not match:
            raise ValueError
        seat = match[1].upper() if match[1] else "GB-" + match[2].upper()
        return seat, value
    except (OSError, ValueError, UnicodeError, TypeError):
        raise FleetError(
            "not_configured",
            "fleet bearer file is missing, unsafe or malformed; no fallback was used",
        ) from None


def bounded_json(raw):
    # Refuse deep nesting before the JSON parser can consume recursion or memory.
    depth = 0
    quoted = escaped = False
    for char in raw:
        if quoted:
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                quoted = False
        elif char == '"':
            quoted = True
        elif char in "[{":
            depth += 1
            if depth > 64:
                raise ValueError
        elif char in "]}":
            depth -= 1
    return json.loads(raw)


def contains_bearer(value, token):
    """Scan decoded strings and keys too, not only their JSON byte spelling."""
    stack = [value]
    visited = 0
    while stack:
        item = stack.pop()
        visited += 1
        if visited > 100_000:
            raise ValueError
        if isinstance(item, str) and token in item:
            return True
        if isinstance(item, dict):
            stack.extend(item.keys())
            stack.extend(item.values())
        elif isinstance(item, (list, tuple)):
            stack.extend(item)
    return False


