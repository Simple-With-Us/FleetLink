{
  "name": "fleetlink",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "fleetlink-files" }],
  "d1_databases": [{ "binding": "DB", "database_name": "fleetlink", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "ADMIN_HOST": "admin.example.invalid",
    "SHARE_HOSTS": "fleetlink.online,fleetlink.app",
    "DEFAULT_SHARE_HOST": "fleetlink.online"
  }
}
