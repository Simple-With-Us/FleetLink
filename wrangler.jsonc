{
  // Describes the production worker for local `wrangler dev` and for reading.
  // Production deploys go through scripts/deploy.sh (Workers script-upload API),
  // which uploads the same bundle with the same bindings and keeps the secret
  // bindings already on the worker.  See DEPLOY.md.
  "name": "fleetlink-api",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-28",
  // Load-bearing posture: no second, unproxied origin, and no Workers Logs,
  // because share passwords can travel in request URLs.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "routes": [
    { "pattern": "fleetlink.online/*", "zone_name": "fleetlink.online" },
    { "pattern": "*.fleetlink.online/*", "zone_name": "fleetlink.online" },
    { "pattern": "fleetlink.app/*", "zone_name": "fleetlink.app" },
    { "pattern": "*.fleetlink.app/*", "zone_name": "fleetlink.app" }
  ],
  "r2_buckets": [{ "binding": "FLEET_SHARES", "bucket_name": "fleet-shares" }],
  // The worker creates and migrates its own tables (worker/lib/schema.mjs).
  "d1_databases": [{ "binding": "DB", "database_name": "fleetlink", "database_id": "85ef083e-9435-49c5-8314-404db547792d" }],
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "WEBAUTHN_RP_ID": "fleetlink.online",
    "WEBAUTHN_ORIGINS": "https://fleetlink.online",
    "WEBAUTHN_RP_NAME": "FleetLink",
    "SHARE_HOSTS": "fleetlink.online,fleetlink.app"
    // Secrets (never vars): ADMIN_SECRET, SESSION_SECRET, SENTRY_DSN,
    // and optionally CF_ANALYTICS_TOKEN (with CF_ZONE_ID) for zone traffic.
  }
}
